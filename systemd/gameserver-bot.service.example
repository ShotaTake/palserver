[Unit]
Description=Game Server Discord Operations Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gameserver-bot
Group=gameserver-bot
WorkingDirectory=/opt/gameserver-ops
EnvironmentFile=/etc/gameserver-bot/bot.env
ExecStart=/opt/gameserver-ops/.venv/bin/gameserver-bot
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
ReadWritePaths=/var/lib/gameserver-bot

[Install]
WantedBy=multi-user.target
