# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_COMMAND_CHANNEL_ID=
DISCORD_AUDIT_CHANNEL_ID=
DISCORD_PLAYER_ROLE_ID=
DISCORD_MAINTAINER_ROLE_ID=

# Server identity
SERVER_MAC_ADDRESS=AA:BB:CC:DD:EE:FF
SERVER_LAN_BROADCAST=192.168.1.255
SERVER_TAILSCALE_HOST=palworld-server
SERVER_SSH_USER=palbotctl
SERVER_SSH_KEY_PATH=/var/lib/palworld-bot/.ssh/id_ed25519
SERVER_SSH_KNOWN_HOSTS_PATH=/var/lib/palworld-bot/.ssh/known_hosts

# Timeouts
WOL_REPEAT_COUNT=3
WOL_REPEAT_INTERVAL_SECONDS=1
SERVER_BOOT_TIMEOUT_SECONDS=240
SSH_COMMAND_TIMEOUT_SECONDS=20
STOP_WAIT_SECONDS=60

# Monitoring / auto shutdown
# Server state is polled this often; open/close changes are announced in the
# audit channel (falls back to the command channel when unset).
STATUS_POLL_INTERVAL_SECONDS=60
# Auto save+backup+poweroff after the server has been empty this long. 0 disables.
IDLE_SHUTDOWN_MINUTES=30

# Public address reporting (/server address). The game port is shown alongside
# the looked-up global IP. The address is re-checked this often and announced
# when it changes; 0 disables the automatic check.
GAME_PORT=8211
PUBLIC_IP_CHECK_INTERVAL_SECONDS=300

# Logging
LOG_LEVEL=INFO

# Fun: /取引 (trade) command. Folder of Pal images to hand out at random.
# Leave empty to use the bundled default (src/palworld_bot/assets/pals).
# Images are not tracked in git; place them on each machine that runs the bot.
PAL_IMAGE_DIR=
