# Valheim dedicated server settings. Installed as /etc/valheim/valheim.env.
#
# Fill this in and hand it to whoever runs scripts/setup/migrate-server.sh:
#   sudo bash scripts/setup/migrate-server.sh --values ~/valheim-values.env
# Without --values the script asks for the same three values interactively.
#
# Never commit the filled-in file. config/*.env is gitignored for that reason.

# Shown in the community server list when VALHEIM_PUBLIC=1.
VALHEIM_NAME=MyValheim

# The world save. A new name creates a new world; an existing one is loaded.
VALHEIM_WORLD=MyWorld

# At least 5 characters, and it must NOT contain the world name — the server
# refuses to start otherwise.
VALHEIM_PASSWORD=changeme

# The query port used for the player count is always this plus one.
VALHEIM_PORT=2456

# 1 lists the server by name so people can find it without knowing the IP,
# which suits a connection whose global address changes. 0 hides it.
VALHEIM_PUBLIC=1
