# Valheim dedicated server settings, installed as /etc/valheim/valheim.env.
#
# These are the DECIDED values for this deployment, not a blank template.
# scripts/setup/migrate-server.sh reads this file when --values is not given,
# and asks only for the fields left empty here.
#
# The password is the one value that cannot live in a public repository, so it
# is empty and gets typed in during setup.

VALHEIM_NAME=kgyValheim

# Fixes the terrain. Changing it later starts a different world.
VALHEIM_WORLD=kgyWorld

# Asked for during setup. At least 5 characters, and it must not contain the
# world name — the server refuses to start otherwise.
VALHEIM_PASSWORD=

# Reuses the number the Palworld server was forwarded on, so the router rule
# can stay as it is. The query port is always this plus one, but that one is
# only ever read over loopback (see scripts/server/valheim-query), so it does
# not need forwarding.
VALHEIM_PORT=35520

# This is not only about the community browser. Measured on the 1.0 server:
# with 0 the Steam query responder stays silent, so the A2S player count times
# out and the bot loses the count, the player names, the presence text and the
# idle auto-shutdown. It must be 1 for those to work.
#
# Being listed also needs UDP <port>+1 forwarded at the router. Without that
# the server effectively stays unlisted while the local query still works —
# which is the setup here: join by IP, and let /server address hand out the
# current one.
VALHEIM_PUBLIC=1

# World modifiers, passed through to the server as extra launch arguments.
# Deliberately unquoted in the unit file so systemd splits them into separate
# arguments — see systemd/valheim-server.service.example.
#
#   resources most      about 3x gathering and drops
#   deathpenalty casual no skill loss, gear stays put
#   portals casual      ore can go through portals, which pairs with 3x
#
# Combat and raids are left alone. If the server fails to start right after a
# game update, empty this line first: the argument names are the part most
# likely to have changed.
VALHEIM_MODIFIERS=-modifier resources most -modifier deathpenalty casual -modifier portals casual
