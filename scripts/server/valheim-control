#!/usr/bin/env bash
set -euo pipefail

# Fixed-command controller for the Valheim dedicated server.
#
# Invoked only through the SSH forced-command wrapper (valheim-control-ssh)
# with one exact command name. It never evaluates arbitrary input and never
# uses a shell to interpret arguments.
#
# Unlike Palworld there is no REST API and no admin password: the player count
# comes from a local A2S query, and a graceful save happens because the systemd
# unit stops the server with SIGINT (see systemd/valheim-server.service.example).

CONFIG_FILE="${GAMESERVER_CONTROL_ENV:-/etc/gameserver-control/control.env}"

# Defaults; override in CONFIG_FILE.
VALHEIM_SERVICE="valheim-server.service"
VALHEIM_QUERY_PORT="2457"
VALHEIM_QUERY_SCRIPT="/usr/local/sbin/valheim-query"
VALHEIM_WORLD_DIR="/home/valheim/.config/unity3d/IronGate/Valheim/worlds_local"
GAMESERVER_BACKUP_SCRIPT="/usr/local/sbin/gameserver-backup"
GAMESERVER_POWEROFF_SCRIPT="/usr/local/sbin/gameserver-safe-poweroff"
VALHEIM_STOP_WAIT_SECONDS="120"

if [ -e "$CONFIG_FILE" ]; then
  # Refuse a group/world-writable config: it would let a non-root user inject
  # settings, including the paths this script trusts.
  if find "$CONFIG_FILE" -maxdepth 0 -perm /022 | grep -q .; then
    printf '%s\n' 'config file must not be group/world writable' >&2
    exit 77
  fi
  # shellcheck source=/dev/null
  . "$CONFIG_FILE"
fi

_service_active() {
  systemctl is-active --quiet "$VALHEIM_SERVICE"
}

_emit_num() {
  # _emit_num KEY VALUE — print "key=value" only when the value looks numeric.
  case "${2:-}" in
    "") return 0 ;;
    *[!0-9.]* | ".") return 0 ;;
    *) printf '%s=%s\n' "$1" "$2" ;;
  esac
}

_query() {
  # Player count and names from the A2S query port. Fails when the server is
  # not answering, so the caller can treat the count as unknown, not zero.
  "$VALHEIM_QUERY_SCRIPT" "$VALHEIM_QUERY_PORT"
}

_uptime_seconds() {
  # Valheim exposes no uptime, so take it from when systemd started the unit.
  local started now
  started="$(systemctl show -p ActiveEnterTimestamp --value "$VALHEIM_SERVICE" 2>/dev/null)"
  [ -n "$started" ] || return 0
  started="$(date -d "$started" +%s 2>/dev/null)" || return 0
  now="$(date +%s)"
  [ -n "$started" ] && [ "$now" -ge "$started" ] && printf '%s' "$((now - started))"
}

cmd_status() {
  if _service_active; then
    printf 'valheim=running\n'
  else
    printf 'valheim=stopped\n'
  fi
  cmd_update_status
  if [ -x /usr/local/sbin/gameserver-maintenance ]; then
    /usr/local/sbin/gameserver-maintenance restore-status
  fi
}

cmd_start() {
  sudo -n systemctl start "$VALHEIM_SERVICE"
  printf 'started\n'
}

cmd_players() {
  _query
}

cmd_shutdown() {
  # The unit is configured with KillSignal=SIGINT, which is what makes Valheim
  # write the world before exiting. A plain SIGTERM would lose progress.
  if ! _service_active; then
    printf 'stopped\n'
    return 0
  fi
  sudo -n systemctl stop "$VALHEIM_SERVICE" || return 1
  local waited=0
  while _service_active; do
    sleep 2
    waited=$((waited + 2))
    if [ "$waited" -ge "$VALHEIM_STOP_WAIT_SECONDS" ]; then
      break
    fi
  done
  if _service_active; then
    printf '%s\n' 'valheim did not stop' >&2
    return 1
  fi
  printf 'stopped\n'
}

cmd_restart() {
  # Stop (which saves via SIGINT) then start again. Uses only the sudo rules
  # already granted for start/stop; the PC never powers off.
  cmd_shutdown >/dev/null
  sudo -n systemctl start "$VALHEIM_SERVICE"
  printf 'restarted\n'
}

cmd_metrics() {
  # Game figures need a running server; the OS ones are always available, so a
  # stopped server still reports something useful. Every value is best effort:
  # a line is omitted rather than guessed.
  if _service_active; then
    _query 2>/dev/null || true
    _emit_num 'uptime' "$(_uptime_seconds)"
  fi

  _emit_num 'loadavg' "$(cut -d' ' -f1 /proc/loadavg 2>/dev/null)"
  _emit_num 'cpu_cores' "$(nproc 2>/dev/null)"

  local mem_total mem_avail
  mem_total="$(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo 2>/dev/null)"
  mem_avail="$(awk '/^MemAvailable:/ {print int($2/1024)}' /proc/meminfo 2>/dev/null)"
  if [ -n "$mem_total" ] && [ -n "$mem_avail" ]; then
    printf 'mem_total_mb=%s\n' "$mem_total"
    printf 'mem_used_mb=%s\n' "$((mem_total - mem_avail))"
  fi

  local df_line
  df_line="$(df -BG --output=pcent,avail "$VALHEIM_WORLD_DIR" 2>/dev/null | tail -n1)"
  if [ -n "$df_line" ]; then
    _emit_num 'disk_use_pct' "$(printf '%s' "$df_line" | grep -oE '[0-9]+%' | tr -d '%')"
    _emit_num 'disk_avail_gb' "$(printf '%s' "$df_line" | grep -oE '[0-9]+G' | tr -d 'G')"
  fi

  local temp_raw
  temp_raw="$(_cpu_temp_millidegrees)"
  if printf '%s' "$temp_raw" | grep -qE '^[0-9]+$'; then
    printf 'cpu_temp=%s\n' "$((temp_raw / 1000))"
  fi
}

_cpu_temp_millidegrees() {
  # Prefer the real CPU sensor (coretemp on Intel, k10temp/zenpower on AMD).
  # thermal_zone0 is only a reliable CPU reading on boards like the Pi; on a
  # desktop it is often an ACPI zone that barely moves, so it is the fallback.
  local hw name input label
  for hw in /sys/class/hwmon/hwmon*; do
    [ -r "$hw/name" ] || continue
    name="$(cat "$hw/name" 2>/dev/null)"
    case "$name" in
      coretemp | k10temp | zenpower)
        for input in "$hw"/temp*_input; do
          [ -r "$input" ] || continue
          label="$(cat "${input%_input}_label" 2>/dev/null || true)"
          case "$label" in
            "Package id 0" | Tctl | Tdie)
              cat "$input"
              return 0
              ;;
          esac
        done
        for input in "$hw"/temp*_input; do
          if [ -r "$input" ]; then
            cat "$input"
            return 0
          fi
        done
        ;;
    esac
  done
  cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || true
}

cmd_backup() {
  if ! "$GAMESERVER_BACKUP_SCRIPT"; then
    _record_stop backup_failed
    return 1
  fi
}

cmd_poweroff() {
  _record_stop requested
  if ! sudo -n "$GAMESERVER_POWEROFF_SCRIPT"; then
    _record_stop poweroff_failed
    return 1
  fi
}

# Shared by the systemd update job and every mutating SSH command. This
# directory is installed by the operator; never create privileged paths here.
UPDATE_DIR=/var/lib/gameserver-control
UPDATE_SERVICE=valheim-update.service
UPDATE_ID=''

_record_stop() {
  [ -d "$UPDATE_DIR" ] || return 0
  local temporary
  temporary="$(mktemp "$UPDATE_DIR/.stop.XXXXXX")"
  printf '%s\n' "$1" > "$temporary"
  mv -f "$temporary" "$UPDATE_DIR/last-stop"
}

_restore_active() {
  [ ! -e "$UPDATE_DIR/restore-block" ] || return 0
  local state
  state="$(systemctl show -p ActiveState --value valheim-restore.service 2>/dev/null)" || return 1
  case "$state" in active|activating|deactivating) return 0 ;; *) return 1 ;; esac
}

_update_active() {
  local state
  state="$(systemctl show -p ActiveState --value "$UPDATE_SERVICE" 2>/dev/null)" || return 1
  case "$state" in active|activating|deactivating) return 0 ;; *) return 1 ;; esac
}

_operation_lock() {
  # Older installations can still use existing commands until update support
  # is installed. The update command itself requires this directory.
  [ -d "$UPDATE_DIR" ] || return 0
  exec 9>"$UPDATE_DIR/operation.lock"
  flock -n 9 || { printf 'operation busy\n' >&2; exit 75; }
}

_set_update_phase() {
  local tmp
  tmp="$(mktemp "$UPDATE_DIR/.update.XXXXXX")"
  printf 'update_id=%s\nupdate_phase=%s\n' "$UPDATE_ID" "$1" > "$tmp"
  mv -f "$tmp" "$UPDATE_DIR/update-state"
}

cmd_update_status() {
  [ -r "$UPDATE_DIR/update-state" ] || return 0
  local content phase
  content="$(cat "$UPDATE_DIR/update-state")"
  phase="$(printf '%s\n' "$content" | sed -n 's/^update_phase=//p')"
  # Interrupted downloads must never be reported as still running forever.
  case "$phase" in
    queued|checking|stopping|backup|downloading|starting)
      if ! _update_active; then
        printf '%s\n' "$content" | sed 's/^update_phase=.*/update_phase=interrupted/'
        return 0
      fi
      ;;
  esac
  printf '%s\n' "$content"
}

cmd_update() {
  [ -d "$UPDATE_DIR" ] || { printf 'update support not installed\n' >&2; return 1; }
  [ "$(systemctl show -p LoadState --value "$UPDATE_SERVICE")" = loaded ] || return 1
  UPDATE_ID="$(date +%s%N)"
  _set_update_phase queued
  # systemd owns the worker, so losing SSH or restarting the bot cannot kill it.
  # Close the inherited lock descriptor in the launcher: the worker takes it.
  if ! sudo -n systemctl start --no-block "$UPDATE_SERVICE" 9>&-; then
    _set_update_phase interrupted
    return 1
  fi
  printf 'update_id=%s\nupdate_phase=queued\n' "$UPDATE_ID"
}

cmd_update_run() {
  # Only the systemd unit invokes this entry point; the SSH wrapper denies it.
  [ -d "$UPDATE_DIR" ] || return 1
  # The requesting SSH process may still hold the lock briefly. Serialize with
  # it, but never wait indefinitely behind another operation.
  exec 9>"$UPDATE_DIR/operation.lock"
  flock -w 60 9 || return 1
  if _restore_active; then return 75; fi
  UPDATE_ID="$(sed -n 's/^update_id=//p' "$UPDATE_DIR/update-state")"
  [[ "$UPDATE_ID" =~ ^[0-9]{1,24}$ ]] || return 1
  _set_update_phase checking
  local state roster count
  state="$(systemctl show -p ActiveState --value "$VALHEIM_SERVICE")"
  case "$state" in
    active)
      if ! roster="$(_query)"; then
        _set_update_phase refused_players
        return 1
      fi
      count="$(printf '%s\n' "$roster" | sed -n 's/^players=//p')"
      if [ "$count" != 0 ]; then
        _set_update_phase refused_players
        return 1
      fi
      ;;
    inactive|failed) ;;
    *) _set_update_phase failed_stop; return 1 ;;
  esac

  _set_update_phase stopping
  if ! cmd_shutdown; then
    _set_update_phase failed_stop
    return 1
  fi
  state="$(systemctl show -p ActiveState --value "$VALHEIM_SERVICE")"
  case "$state" in
    inactive|failed) ;;
    *) _set_update_phase failed_stop; return 1 ;;
  esac
  _set_update_phase backup
  if ! cmd_backup; then
    _set_update_phase failed_backup
    return 1
  fi
  _set_update_phase downloading
  if ! sudo -n -H -u valheim /usr/local/sbin/valheim-steam-update; then
    _set_update_phase failed_download
    return 1
  fi
  _set_update_phase starting
  if ! sudo -n systemctl start "$VALHEIM_SERVICE"; then
    _set_update_phase failed_start
    return 1
  fi
  # systemd's "active" alone does not mean a world is ready for players.
  local attempt
  for attempt in $(seq 1 60); do
    if _service_active && _query >/dev/null 2>&1; then
      _set_update_phase succeeded
      return 0
    fi
    sleep 5
  done
  _set_update_phase failed_start
  return 1
}

# Prevent concurrent mutation even across separate SSH connections or a bot
# restart. Status/players/metrics remain available throughout the update.
case "${1:-}" in
  start|restart|shutdown|backup|poweroff|update)
    if _update_active || _restore_active; then printf 'maintenance busy\n' >&2; exit 75; fi
    _operation_lock
    # Recheck after acquiring the lock to close the enqueue race.
    if _update_active || _restore_active; then printf 'maintenance busy\n' >&2; exit 75; fi
    ;;
esac

case "${1:-}" in
  status) cmd_status ;;
  start) cmd_start ;;
  players) cmd_players ;;
  metrics) cmd_metrics ;;
  restart) cmd_restart ;;
  shutdown)
    if ! cmd_shutdown; then _record_stop shutdown_failed; exit 1; fi
    ;;
  backup) cmd_backup ;;
  poweroff) cmd_poweroff ;;
  update) cmd_update ;;
  update-run) cmd_update_run ;;
  *)
    printf '%s\n' 'invalid command' >&2
    exit 64
    ;;
esac
