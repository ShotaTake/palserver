#!/usr/bin/env bash
set -euo pipefail

# Archive the Valheim world data. Intended to run after the server has stopped
# so the archive is consistent. Prints "backup ok" and exits 0 on success; the
# orchestrator only powers the machine off when this succeeds.
#
# Valheim needs BOTH <world>.db (the world) and <world>.fwl (its metadata), so
# the whole directory is archived rather than individual files.

# Run from a directory every account can reach: this may be invoked over SSH as
# a service user whose working directory is another user's home.
cd /

CONFIG_FILE="${GAMESERVER_CONTROL_ENV:-/etc/gameserver-control/control.env}"

VALHEIM_WORLD_DIR="/home/valheim/.config/unity3d/IronGate/Valheim/worlds_local"
GAMESERVER_BACKUP_DIR="/var/lib/gameserver-backups"
GAMESERVER_BACKUP_KEEP="10"

if [ -e "$CONFIG_FILE" ]; then
  if find "$CONFIG_FILE" -maxdepth 0 -perm /022 | grep -q .; then
    printf '%s\n' 'config file must not be group/world writable' >&2
    exit 77
  fi
  # shellcheck source=/dev/null
  . "$CONFIG_FILE"
fi

if [ ! -d "$VALHEIM_WORLD_DIR" ]; then
  printf '%s\n' 'world directory not found' >&2
  exit 1
fi

mkdir -p "$GAMESERVER_BACKUP_DIR"
timestamp="$(date '+%Y%m%d-%H%M%S')"
archive="${GAMESERVER_BACKUP_DIR}/valheim-world-${timestamp}.tar.gz"
tmp_archive="${archive}.partial"

# Build into a temp name first so a crash never leaves a truncated archive that
# later looks like a valid backup.
tar -czf "$tmp_archive" -C "$(dirname "$VALHEIM_WORLD_DIR")" "$(basename "$VALHEIM_WORLD_DIR")"
mv "$tmp_archive" "$archive"

if ! tar -tzf "$archive" >/dev/null 2>&1; then
  printf '%s\n' 'backup verification failed' >&2
  rm -f "$archive"
  exit 1
fi

# Retention: keep the newest N archives.
if [ "$GAMESERVER_BACKUP_KEEP" -gt 0 ] 2>/dev/null; then
  mapfile -t old < <(ls -1t "${GAMESERVER_BACKUP_DIR}"/valheim-world-*.tar.gz 2>/dev/null \
    | tail -n +"$((GAMESERVER_BACKUP_KEEP + 1))")
  if [ "${#old[@]}" -gt 0 ]; then
    rm -f "${old[@]}"
  fi
fi

printf 'backup ok: %s\n' "$(basename "$archive")"
