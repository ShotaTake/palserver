#!/usr/bin/env bash
set -euo pipefail

# Power the machine off, but only once the game server is stopped. This is a
# defence-in-depth check: the orchestrator already runs shutdown + backup
# first, and this refuses to cut power while the server is still running.
#
# Install root-owned 0755 and grant it to the bot account via a narrow sudoers
# rule. Set GAMESERVER_POWEROFF_DRYRUN=1 to log the action instead.

cd /

CONFIG_FILE="${GAMESERVER_CONTROL_ENV:-/etc/gameserver-control/control.env}"

VALHEIM_SERVICE="valheim-server.service"
GAMESERVER_POWEROFF_DRYRUN="0"

if [ -e "$CONFIG_FILE" ]; then
  if find "$CONFIG_FILE" -maxdepth 0 -perm /022 | grep -q .; then
    printf '%s\n' 'config file must not be group/world writable' >&2
    exit 77
  fi
  # shellcheck source=/dev/null
  . "$CONFIG_FILE"
fi

if systemctl is-active --quiet "$VALHEIM_SERVICE"; then
  printf '%s\n' 'refusing to power off: the game server is still running' >&2
  exit 1
fi

if [ "$GAMESERVER_POWEROFF_DRYRUN" = "1" ]; then
  printf 'poweroff skipped (dry run)\n'
  exit 0
fi

exec systemctl poweroff
