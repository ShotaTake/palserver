#!/usr/bin/env bash
set -euo pipefail

# TEMPLATE ONLY. Install as root-owned 0755 after review.
# This wrapper deliberately accepts only exact command names.

case "${SSH_ORIGINAL_COMMAND:-}" in
  status)   exec /usr/local/sbin/valheim-control status ;;
  start)    exec /usr/local/sbin/valheim-control start ;;
  players)  exec /usr/local/sbin/valheim-control players ;;
  metrics)  exec /usr/local/sbin/valheim-control metrics ;;
  restart)  exec /usr/local/sbin/valheim-control restart ;;
  shutdown) exec /usr/local/sbin/valheim-control shutdown ;;
  backup)   exec /usr/local/sbin/valheim-control backup ;;
  poweroff) exec /usr/local/sbin/valheim-control poweroff ;;
  *)
    printf '%s\n' 'command denied' >&2
    exit 64
    ;;
esac
